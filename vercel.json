{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/videos/sync",
      "schedule": "0 2,10,18 * * *"
    },
    {
      "path": "/api/videos/monitor-analysis",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/videos/alerts-24h",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/videos/digest",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/videos/investors-24h",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/videos/backfill-snapshots",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/videos/health-check",
      "schedule": "0 8 * * *"
    }
  ]
}
